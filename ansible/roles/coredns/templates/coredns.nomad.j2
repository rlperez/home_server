job "coredns" {
  datacenters = [{% for dc in coredns_config.datacenters %}"{{ dc }}"{% if not loop.last %}, {% endif %}{% endfor %}]
  type        = "system"

  group "dns" {
    network {
      mode = "host"

      port "dns" {
        static = 53
      }

      port "health" {
        static = 8080
      }

      port "ready" {
        static = 8181
      }
    }

    service {
      name         = "coredns"
      port         = "dns"
      address_mode = "host"
      tags         = ["dns", "infra"]

      check {
        name     = "tcp-53"
        type     = "tcp"
        port     = "dns"
        interval = "10s"
        timeout  = "2s"
      }

      check {
        name     = "health-endpoint"
        type     = "http"
        path     = "/health"
        port     = "health"
        interval = "10s"
        timeout  = "2s"
      }

      check {
        name     = "ready-endpoint"
        type     = "http"
        path     = "/ready"
        port     = "ready"
        interval = "10s"
        timeout  = "3s"
      }
    }

    task "coredns" {
      driver = "podman"

      config {
        image        = "{{ coredns_config.image }}"
        network_mode = "host"

        args = [
          "-conf",
          "/etc/coredns/Corefile"
        ]

        cap_add = [
          "NET_BIND_SERVICE"
        ]

        volumes = [
          "{{ coredns_config.data_dir }}/Corefile:/etc/coredns/Corefile:ro,Z",
          "{{ coredns_config.data_dir }}/home.arpa.db:/etc/coredns/home.arpa.db:ro,Z"
        ]
      }

      env {
        GOMEMLIMIT = "{{ coredns_config.go_mem_limit }}"
      }

      resources {
        cpu    = {{ coredns_config.cpu }}
        memory = {{ coredns_config.memory }}
      }
    }
  }
}
