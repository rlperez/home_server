job "forgejo-runner" {
  datacenters = [{% for dc in forgejo_runner_config.datacenters %}"{{ dc }}"{% if not loop.last %}, {% endif %}{% endfor %}]
  namespace   = "{{ forgejo_runner_config.namespace }}"
  type        = "service"

  group "runner" {
    count = 1

    restart {
      attempts = 3
      interval = "30m"
      delay    = "15s"
      mode     = "delay"
    }

    task "runner" {
      driver = "podman"

      config {
        image = "{{ forgejo_runner_config.image }}"

        command = "forgejo-runner"
        args = [
          "daemon",
          "-c",
          "/data/config.yml"
        ]

        volumes = [
          "{{ forgejo_runner_config.data_dir }}/data:/data:Z",
          "/run/user/1000/podman/podman.sock:/run/user/1000/podman/podman.sock",
        ]
      }

      user = "{{ forgejo_runner_config.uid }}"

      env {
        HOME            = "/data"
        XDG_RUNTIME_DIR = "/run/user/1000"
      }

      resources {
        cpu    = {{ forgejo_runner_config.resources.cpu }}
        memory = {{ forgejo_runner_config.resources.memory }}
      }
    }
  }
}
