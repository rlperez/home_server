job "forgejo-runner" {
  datacenters = [{% for dc in forgejo_runner_config.datacenters %}"{{ dc }}"{% if not loop.last %}, {% endif %}{% endfor %}]
  namespace   = "{{ forgejo_runner_config.namespace }}"
  type        = "service"

  group "runner" {
    count = 1

    update {
      max_parallel      = 1
      health_check      = "checks"
      min_healthy_time  = "10s"
      healthy_deadline  = "5m"
      progress_deadline = "10m"
    }

    restart {
      attempts = 3
      interval = "30m"
      delay    = "15s"
      mode     = "delay"
    }

    task "runner" {
      driver = "podman"

      config {
        image = "{{ forgejo_runner_config.image }}"

        command = "forgejo-runner"
        args = [
          "daemon",
          "-c",
          "/data/config.yml",
        ]

        security_opt = [
          "label=disable",
        ]

        volumes = [
          "{{ forgejo_runner_config.data_dir }}:/data:Z",
          "{{ forgejo_runner_config.podman_socket }}:{{forgejo_runner_config.podman_socket}}",
        ]
      }

      user = "{{ forgejo_runner_config.uid }}"

      env {
        HOME            = "/data"
        XDG_RUNTIME_DIR = "/run/user/{{ forgejo_runner_config.uid }}"
      }

      resources {
        cpu    = {{ forgejo_runner_config.resources.cpu }}
        memory = {{ forgejo_runner_config.resources.memory }}
      }
    }
  }
}
